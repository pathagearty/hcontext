# Default local deterministic-harness provider
MODEL_PROVIDER=mock

# Target two-agent Microsoft Foundry implementation (not yet wired into the app)
# Authenticate through an approved Entra developer identity locally and managed identity in Azure.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MANUFACTURING_MODEL=
FOUNDRY_HEXACONTEXT_MODEL=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Legacy generic Azure explanation adapter used by the current deterministic harness
# A requested live provider must fail explicitly when this configuration is absent.
AZURE_FOUNDRY_RESPONSES_URL=
AZURE_FOUNDRY_MODEL=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_BEARER_TOKEN=

# AWS Bedrock (adapter is included; access and model ID must be approved)
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_BEDROCK_MODEL_ID=

# Optional future services
POSTGRES_DSN=
FALKORDB_URL=
OPA_URL=
