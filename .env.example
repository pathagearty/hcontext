# Default local deterministic-harness provider
MODEL_PROVIDER=mock

# Verified saved-agent Microsoft Foundry Responses endpoints.
# Authenticate through Azure CLI locally and managed identity in Azure. Never store a bearer token here.
FOUNDRY_ENABLED=false
FOUNDRY_API_VERSION=2025-05-15-preview
FOUNDRY_PROJECT_ENDPOINT=
# Agent 1: direct arm. This agent receives fragmented source-domain tools and
# must gather/reconcile evidence before recommending PASS/HOLD/ESCALATE readiness.
FOUNDRY_DIRECT_REVIEW_AGENT_ID=
FOUNDRY_DIRECT_REVIEW_AGENT_ENDPOINT=
FOUNDRY_DIRECT_REVIEW_MODEL=gpt-5
# Agent 2: HexaContext layer. This agent applies a reusable Decision Profile to
# the governed Context Core and emits a validated DecisionPacket. It never makes
# the final disposition and must not be presented as using Agent 1's tool contract.
FOUNDRY_HEXACONTEXT_COMPILER_AGENT_ID=
FOUNDRY_HEXACONTEXT_COMPILER_AGENT_ENDPOINT=
FOUNDRY_HEXACONTEXT_COMPILER_MODEL=gpt-5
# Agent 3 / canonical role key context_assisted_review: this agent receives only
# the DecisionPacket and performs the same readiness task as Agent 1. No source
# or Context Core retrieval is allowed. CONTEXT_REVIEW is retained as the current
# environment-variable prefix for compatibility.
FOUNDRY_CONTEXT_REVIEW_AGENT_ID=
FOUNDRY_CONTEXT_REVIEW_AGENT_ENDPOINT=
FOUNDRY_CONTEXT_REVIEW_MODEL=gpt-5
FOUNDRY_AUTH_MODE=auto
FOUNDRY_MANAGED_IDENTITY_CLIENT_ID=
FOUNDRY_TIMEOUT_SECONDS=120
FOUNDRY_MAX_RETRIES=2
FOUNDRY_MAX_OUTPUT_TOKENS=1800
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Legacy generic Azure explanation adapter used by the current deterministic harness
# A requested live provider must fail explicitly when this configuration is absent.
AZURE_FOUNDRY_RESPONSES_URL=
AZURE_FOUNDRY_MODEL=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_BEARER_TOKEN=

# AWS Bedrock (adapter is included; access and model ID must be approved)
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_BEDROCK_MODEL_ID=

# Backend-only Supabase source. The schema/migrations exist; live comparison
# orchestration through the remote Data API remains to be implemented.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_SNAPSHOT_ID=hx-mfg-v2-snapshot-001
SUPABASE_AS_OF_TIME=2026-08-01T12:00:00Z
# Optional operator-only API token. Never expose this value to either agent.
EVALUATOR_UI_TOKEN=
SUPABASE_TIMEOUT_SECONDS=15
POSTGRES_DSN=
FALKORDB_URL=
OPA_URL=
